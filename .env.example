# Copy this file to .env and fill in your values. Never commit .env.

# The Compose Postgres (`docker compose up -d`). Tests use the `pickled_test` database
# on the same server; set TEST_DATABASE_URL to point them somewhere else.
DATABASE_URL=postgresql+psycopg://pickled:pickled@localhost:5432/pickled

# Runware's Anthropic-compatible endpoint (ADR 0004).
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai

# Models per role. Opus can be turned on per setting; Haiku isn't on Runware.
PICKLED_CHAT_MODEL=claude-sonnet-5-5
PICKLED_DRAFT_MODEL=claude-sonnet-5-5
PICKLED_MATCH_MODEL=claude-sonnet-5-5
PICKLED_JUDGE_MODEL=claude-sonnet-5-5
PICKLED_LLM_TIMEOUT_SECONDS=120
PICKLED_LLM_MAX_RETRIES=2

# LLM spend (ADR 0009).
PICKLED_LLM_MONTHLY_CAP_USD=25
PICKLED_LLM_MIN_BALANCE_USD=5
